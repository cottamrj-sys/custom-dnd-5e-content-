{"system":"5e","resource_id":"race","stats":{"name":{"value":"Golynn"},"source":{"value":"00e7ba8d-b6c0-4f5d-b99f-5d7afaed4d42"},"base_ac":{"value":13},"same_ac_as_parent":{"value":false},"speed":{"value":30},"burrow_speed":{"value":15},"ability_score_increases":{"value":[{"system":"5e","resource_id":"ability_score_increase","stats":{"modifier_options":{"value":["constitution"]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"1b411f35-9ce6-4f20-89da-9694a0b3176d","value":{"value":2}}},{"system":"5e","resource_id":"ability_score_increase","stats":{"modifier_options":{"value":["strength"]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"1ba87338-e410-4634-860f-899df0bd9144"}}]},"traits":{"value":[{"system":"5e","resource_id":"feat","stats":{"name":{"value":"Age"},"descriptions":{"value":[{"system":"5e","resource_id":"levelled_description","stats":{"description":{"value":"Golynn grow rapidly and reach maturity at 10 years of age. On average, they live about 150 years."},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"0286327b-750e-4e42-bdd9-9836027e5497"}}]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"age"}},{"system":"5e","resource_id":"feat","stats":{"name":{"value":"Size"},"descriptions":{"value":[{"system":"5e","resource_id":"levelled_description","stats":{"description":{"value":"Golynn stand between 7 and 8 feet tall and average between 300 and 400 pounds. Your size is Medium."},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"d536d6b8-80d3-41e1-bc5d-1f33c7d246d5"}}]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"size"}},{"system":"5e","resource_id":"feat","stats":{"name":{"value":"Natural Armour"},"descriptions":{"value":[{"system":"5e","resource_id":"levelled_description","stats":{"description":{"value":"Your body is covered in thick, keratinous scales. When you aren’t wearing armour, your AC is 13 + your Dexterity modifier. You can use your natural armour to determine your AC if the armour you wear would leave you with a lower AC. A shield’s benefits apply as normal while you use your natural armour."},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"0d2c2d08-22dd-4178-b794-80cbb0e9a3ae"}}]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"natural_armour"}},{"system":"5e","resource_id":"feat","stats":{"name":{"value":"Powerful Build"},"descriptions":{"value":[{"system":"5e","resource_id":"levelled_description","stats":{"description":{"value":"You count as one size larger when determining your carrying capacity and the weight you can push, drag, or lift."},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"ffcb83af-22fa-4acc-afed-dfff1b0935df"}}]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"powerful_build"}},{"system":"5e","resource_id":"feat","stats":{"name":{"value":"Shovel Talons"},"descriptions":{"value":[{"system":"5e","resource_id":"levelled_description","stats":{"description":{"value":"Your wide, powerful claws are perfect for creating tunnels and burrows. You have a burrowing speed of 15 feet, but can only use it to tunnel through soft earth, or loose stone."},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"0c442839-d12d-4b2d-907d-e992dc39585d"}}]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"shovel_talons"}},{"system":"5e","resource_id":"feat","stats":{"name":{"value":"Drill Dervish"},"descriptions":{"value":[{"system":"5e","resource_id":"levelled_description","stats":{"description":{"value":"While burrowing underground, you can shift the ground under a creature’s feet, potentially causing it to fall over. If you burrow directly under a Large or smaller creature that is standing on the ground, the creature must succeed on a Strength saving throw or be knocked prone. The DC for this saving throw equals 8 + your Strength modifier + your proficiency bonus."},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"2e01abf0-72ef-4526-8bb4-fda53c49c43f"}}]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"drill_dervish"}},{"system":"5e","resource_id":"feat","stats":{"name":{"value":"Tremorsense"},"descriptions":{"value":[{"system":"5e","resource_id":"levelled_description","stats":{"description":{"value":"Knowing where the next meal—like a juicy, giant earthworm—can be found while underground requires a specific adaptation. You have tremorsense out to a range of 5 feet. As an action, you can hone your senses, increasing the range of this sense out to 20 feet until the end of your next turn."},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"5bdcc6fa-82ea-4a74-9129-ead585ccb102"}}]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"tremorsense"}}]},"unarmed_strike":{"value":[]},"same_spellcasting_ability_as_parent":{"value":false},"language_proficiencies":{"value":[{"system":"5e","resource_id":"levelled_choice_text","stats":{"options":{"value":"Common"},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"c900c597-ac3e-4d48-9412-87264019c48c"}},{"system":"5e","resource_id":"levelled_choice_text","stats":{"options":{"value":"Choose 1"},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"7433100d-ddb9-4e05-b12b-c6c5678636c4"}}]},"skill_proficiencies":{"value":[]},"armor_proficiencies":{"value":[]},"weapon_proficiencies":{"value":[]},"tool_proficiencies":{"value":[]},"subraces":{"value":[]},"updated_at":{"value":"2026-08-11T17:44:40.727639+00:00"},"id":"d6355f63-9ed5-4ede-954c-8570c0dd4893","user_created":true}}